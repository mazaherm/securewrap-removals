# Optional: enables a fuller "Find address" list via getAddress.io
# (every premise at a postcode). Without this, Find address still works
# using free postcodes.io + OpenStreetMap data — it validates the
# postcode, fills the town, and lists addresses when OSM has them.
# Sign up for a key at https://getaddress.io if you want PAF-complete lists.
GETADDRESS_API_KEY=

# --- Backend: quote storage, email, admin dashboard -------------------
# All optional individually, but needed together for: recording every
# quote (with the customer's email) for a 24hr follow-up, an admin view
# of all quotes, and emailing a checklist copy to you (the packer) when a
# customer accepts. Without these, the site still works exactly as
# before — quotes just aren't persisted anywhere, and no emails go out.
# See README.md "Backend setup" for the full setup steps.

# Supabase (https://supabase.com — free tier). Create a project, run
# supabase/schema.sql in its SQL editor, then copy these from
# Project Settings → API. SUPABASE_SERVICE_ROLE_KEY is a secret — never
# expose it to the browser or commit it.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (https://resend.com — free tier) for sending emails. For testing
# you can leave RESEND_FROM_EMAIL unset to send from onboarding@resend.dev;
# for production, verify your own domain in Resend and set this to an
# address on it.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Your own inbox — receives a copy of the checklist whenever a customer
# accepts a quote, so you always have the job even if the customer never
# opens their checklist.
PACKER_EMAIL=

# Password for the /admin dashboard (list of all quotes). Pick something
# you don't use elsewhere — this is compared directly, so keep it secret.
ADMIN_PASSWORD=

# Used in emails to build links back to the site (e.g. the checklist
# link). Set this to your real deployed URL once live, e.g.
# https://securewrapremovals.co.uk — defaults to localhost for dev.
NEXT_PUBLIC_SITE_URL=

# Set this once deployed on Vercel to protect the 24hr follow-up cron
# endpoint (Vercel sends it automatically as a Bearer token — see
# vercel.json). Any random string works; without it the endpoint is
# left open, which is fine for local testing but not for production.
CRON_SECRET=
