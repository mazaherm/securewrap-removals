# Optional: enables automatic item-type detection from uploaded photos
# (used in the "Choose protection" step to suggest e.g. "TV" from a photo).
# Without this set, the app falls back to guessing from the photo's
# filename and lets the customer pick the item type manually — the quote
# tool still works fully, just without the AI suggestion.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: override the model used for item-photo classification.
# Must be a Claude model with vision support. Defaults to claude-sonnet-5.
ANTHROPIC_VISION_MODEL=

# Optional: enables "Find address" — the customer enters a postcode and
# picks their address from a list, instead of typing it all out. Without
# this set, the postcode field still checks distance from our Milton
# Keynes base (via the free postcodes.io — no key needed for that part),
# but the customer types their address manually.
# Sign up for a key at https://getaddress.io (or swap the provider in
# app/api/address/lookup/route.ts for one you already use).
GETADDRESS_API_KEY=
